# Optional: email the calendar invites. Without these, invites are only
# written to invites/ as .ics files. For Gmail use an app password:
# https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-app-password

# Optional: send every invite to this address instead of the candidate's,
# for testing. The sample resumes use made-up example.com addresses.
# INVITE_TEST_EMAIL=you@gmail.com
