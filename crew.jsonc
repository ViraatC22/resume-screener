{
  // Display name for this crew
  "name": "resume_screener",

  // Each name must match agents/<name>.jsonc exactly.
  "agents": [
    "resume_parser",
    "candidate_screener",
    "interview_scheduler"
  ],

  // Tasks run top to bottom because process is sequential.
  "tasks": [
    {
      "name": "parse_resumes_task",

      "description": "Use the Resume Reader Tool once to read every resume in the resumes folder. For each resume, extract: full name, email, phone, current or most recent job title, total years of professional experience, every job held (title, company, dates, and what they did), technical skills, education, and up to three notable achievements. The resumes use different layouts, section names, and date formats, and some are missing sections, so read each one carefully and write 'not listed' for anything that is missing. Do not judge or score the candidates.",

      "expected_output": "One Markdown block per resume, in the order the tool returned them, every resume exactly once, each in this exact format:\n\n### <Name>\n- File: <file name>\n- Email: <email>\n- Phone: <phone>\n- Current title: <title>\n- Years of experience: <number>\n- Work history: <one line per job: title at company (dates): what they did>\n- Skills: <comma-separated list>\n- Education: <degree or training and field of study only, without school names or years>\n- Notable achievements: <up to three, with numbers where given>",

      "agent": "resume_parser",

      // Blind screening: checks every resume was parsed once, saves names and
      // contact details to candidates.json, and passes the screener anonymous
      // profiles labelled C1, C2, ...
      "guardrail": {"python": "tools.blind_screening.anonymize_candidates"}
    },
    {
      "name": "screen_candidates_task",

      "description": "Screen every anonymous candidate for the {role} role. Requirements: {role_requirements} Score each candidate from 1 to 10 against these requirements. Rubric: 8-10 = meets every must-have through professional work, with measurable impact; 5-7 = meets some must-haves but has clear gaps in depth or experience; 1-4 = meets few or none. Weigh professional work history most heavily: a long skills list without jobs or projects that demonstrate those skills counts for little, and buzzwords or self-praise count for nothing. The profiles are anonymous on purpose. Judge only job-related evidence. Refer to each candidate by ID or as 'the candidate', never guess or mention gender, age, race, nationality, religion, family status, or disability, and don't use he/she pronouns. Every candidate ID must be scored exactly once.",

      // Code ranks, shortlists, and books slots from these scores (see
      // tools/blind_screening.py), so the model only has to judge.
      "expected_output": "One entry per candidate ID, in the same order as the profiles, each in this exact format:\n\n### <ID>: <score>/10\n<2-3 sentences citing specific evidence from the profile>",

      "agent": "candidate_screener",

      // Only the parsed data — keeps the small model's context focused.
      "context": ["parse_resumes_task"],

      // Rejects answers that skip a candidate or mention protected
      // characteristics, then builds the ranked report with names added back.
      "guardrail": {"python": "tools.blind_screening.check_screening"},

      "output_file": "report.md"
    },
    {
      "name": "schedule_interviews_task",

      "description": "Send an interview invite to every candidate in the Shortlist section of the screening report, and to no one else. Call the Calendar Invite Tool once per shortlisted candidate with their candidate ID (for example C3). The tool looks up their email and interview time. If the shortlist says None, send nothing.",

      "expected_output": "A short Markdown list of the invites sent, with each candidate's ID, name, interview time, and the tool's confirmation message. If nobody was shortlisted, say so.",

      "agent": "interview_scheduler",

      "context": ["screen_candidates_task"]
    }
  ],

  "process": "sequential",

  "verbose": true,

  // Off: memory needs an embeddings provider (OpenAI by default), and each
  // screening run should start fresh anyway.
  "memory": false,

  "tracing": false,

  // The role being hired for. `crewai run` uses these without prompting;
  // edit them to screen for a different role. Interviews are booked hourly
  // from 10:00 on the next business day.
  "inputs": {
    "role": "Backend Software Engineer (Python)",
    "role_requirements": "Must have: 3+ years of professional backend development; production Python with a web framework (Django, FastAPI, or Flask); relational databases and SQL; automated testing. Nice to have: AWS or GCP; Docker or Kubernetes; message queues such as Kafka, Celery, or RabbitMQ; owning services end to end or mentoring."
  }
}
